{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hoxel-traffic-camera-vanilla-benchmark",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  }
}
