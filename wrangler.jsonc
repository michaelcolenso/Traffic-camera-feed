{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoxel-traffic-camera-feed",
  "main": "./prototype/vanilla/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "cams.hoxel.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./prototype/vanilla/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*"
    ]
  }
}
