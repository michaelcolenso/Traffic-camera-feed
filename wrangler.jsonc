{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoxel-traffic-camera-feed",
  "main": "./prototype/vanilla/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "cams.hoxel.dev",
      "custom_domain": true
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "directory": "./prototype/vanilla/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "HISTORY_DB",
      "database_name": "hoxel-traffic-camera-history",
      "database_id": "4044309c-9326-4713-93eb-a5e5b47965f4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HISTORY_BUCKET",
      "bucket_name": "hoxel-traffic-camera-history"
    }
  ]
}
